/* USER CODE BEGIN 4 */
float PID_Calculate(PID_USE *p, float tar, float now) //PID算法
{
  float error = tar - now;
  float d_error = error - p->e_last;

  p->integral += error;
  if (p->integral >  p->i_max) p->integral =  p->i_max;
  if (p->integral < -p->i_max) p->integral = -p->i_max;

  float output = p->Kp * error + p->Ki * p->integral + p->Kd * d_error; //WHAT CAN I SAY

  p->e_last = error;

  if (output >  p->out_max) output =  p->out_max; //限幅
  if (output < -p->out_max) output = -p->out_max;
  return output;
}

void MOTOR_Control(int16_t u)
{
  /* u 已被 PID.out_max 限幅；两个通道每次都要写，否则 H 桥会同时有效（刹车） */
  int32_t ccr = PWM_DEAD + (u >= 0 ? u : -u);

  if (u > 0)
  {
    __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_1, ccr);
    __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_2, 0);
  }
  else if (u < 0)
  {
    __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_1, 0);
    __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_2, ccr);
  }
  else
  {
    __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_1, 0);
    __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_2, 0);
  }
}

/* 按当前 g_mode 和 g_tick 生成目标速度（RPM），每个控制周期调用一次 */
int32_t TARGET_Control(void)
{
  float t = g_tick * CTRL_PERIOD;
  float v;

  switch (g_mode)
  {
    case WAVE_STEP:       /* 阶跃：100 -> 200 -> 300 -> 100，每段 4 s */
      v = (t < 4.0f) ? 100.0f : (t < 8.0f) ? 200.0f : (t < 12.0f) ? 300.0f : 100.0f;
      break;

    case WAVE_SINE_FIX:   /* 固定正弦：0.5 Hz、幅度 50、中心 200 */
      v = 200.0f + 50.0f * sinf(TWO_PI * 0.5f * t);
      break;

    case WAVE_SINE_SWEEP: /* 变频变幅：0.2 -> 2.6 Hz，30 -> 80，12 s 一轮；用相位累加保证波形连续 */
    {
      float p = fmodf(t, 12.0f) / 12.0f;
      float f = 0.2f + 2.4f * p;
      float a = 30.0f + 50.0f * p;
      g_phase += TWO_PI * f * CTRL_PERIOD;
      if (g_phase > TWO_PI) g_phase -= TWO_PI;
      v = 200.0f + a * sinf(g_phase);
      break;
    }

    default:
      v = 200.0f;
      break;
  }

  if (v < 0.0f) v = 0.0f;   /* 速度环不生成负目标 */
  return (int32_t)v;
}

void BUFFER_Send(void)
{
  char buf[32];

  //关中断取一份快照，保证 target 和 speed 属于同一个控制周期
  __disable_irq();
  int32_t target = g_target;
  float   speed  = g_speed;
  g_new_sample = 0;
  __enable_irq();

  /* VOFA FireWater：逗号分隔 + 换行，不依赖 printf 重定向 */
  int len = snprintf(buf, sizeof(buf), "%d,%d\n", (int)target, (int)speed);
  HAL_UART_Transmit(&huart1, (uint8_t *)buf, (uint16_t)len, 10);
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
  if (htim->Instance != TIM1) return;

  /* (1) 测速 */
  int16_t now_cnt = (int16_t)__HAL_TIM_GET_COUNTER(&htim2);
  int16_t delta   = now_cnt - g_last_cnt; 
  g_last_cnt = now_cnt;
  g_speed = (float)delta * 60.0f / (PPR * CTRL_PERIOD);

  /* (2) 生成目标波形 */
  g_target = TARGET_Control();
  if (++g_tick >= WAVE_TICKS) g_tick = 0;

  /* (3) PID 计算 */
  float u = PID_Calculate(&PID, (float)g_target, g_speed);

  /* (4) 输出到电机，并通知主循环发一帧 */
  MOTOR_Control((int16_t)u);
  g_new_sample = 1;
}
/* USER CODE END 4 */

