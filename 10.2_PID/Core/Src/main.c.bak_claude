/* Private typedef -----------------------------------------------------------*/
/* USER CODE BEGIN PTD */
typedef struct {
  float Kp, Ki, Kd;
  float e_last; //上次误差
  float integral; //累加积分
  float out_max; //输出限幅
  float i_max; //积分限幅
} PID_USE;

typedef enum {
  WAVE_STEP = 0,//阶跃
  WAVE_SINE_FIX,
  WAVE_SINE_SWEEP
} WAVE_MODE;
/* USER CODE END PTD */

/* Private define ------------------------------------------------------------*/
/* USER CODE BEGIN PD */
#define PWM_DEAD 500 //死区：CCR 低于此值电机不转（输出上限由 PID.out_max 决定）
#define PPR 1320.0f  //输出轴一圈的脉冲数（x4 倍频后）
#define CTRL_PERIOD 0.010f //控制周期 10 ms
#define WAVE_TICKS 6000    //波形循环一轮的节拍数（60 s）
#define TWO_PI 6.2831853f
/* USER CODE END PD */

/* Private macro -------------------------------------------------------------*/
/* USER CODE BEGIN PM */

/* USER CODE END PM */

/* Private variables ---------------------------------------------------------*/
TIM_HandleTypeDef htim1;
TIM_HandleTypeDef htim2;
TIM_HandleTypeDef htim3;

UART_HandleTypeDef huart1;

/* USER CODE BEGIN PV */
static PID_USE PID = {
  .Kp = 0.5f, .Ki = 0.03f, .Kd = 0.00f,
  .e_last = 0.0f, .integral = 0.0f,
  .out_max = 450.0f, .i_max = 3000.0f,
};

static int16_t g_last_cnt = 0;            //上次编码器计数
static uint32_t g_tick = 0;               //控制节拍计数（波形时间 = g_tick * CTRL_PERIOD）
static float g_phase = 0.0f;              //变频正弦的相位累加
static WAVE_MODE g_mode = WAVE_STEP;      //在这里选波形：WAVE_STEP / WAVE_SINE_FIX / WAVE_SINE_SWEEP
static volatile int32_t g_target = 0;     //目标速度 RPM（中断写，主循环读）
static volatile float g_speed = 0.0f;     //实际速度 RPM（中断写，主循环读）
static volatile uint8_t g_new_sample = 0; //中断置 1，主循环发完清 0
/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_TIM1_Init(void);
static void MX_TIM2_Init(void);
static void MX_TIM3_Init(void);
static void MX_USART1_UART_Init(void);
void Error_Handler(void);
/* USER CODE BEGIN PFP */
float PID_Calculate(PID_USE *p, float tar, float now);
int32_t TARGET_Control(void);
void MOTOR_Control(int16_t u);
void BUFFER_Send(void);
/* USER CODE END PFP */

